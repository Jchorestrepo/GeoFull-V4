# =================================================================
# GeoFull V4 — Backend Environment Variables Configuration (.env)
# =================================================================

# Información del Proyecto
PROJECT_NAME="GeoFull V4 API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Claves de Seguridad JWT
SECRET_KEY="geofull_v4_secret_key_change_in_production_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base de Datos PostgreSQL 16 + PostGIS (Docker o Servidor VPS)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgis_secure_pass_2026"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5433"
POSTGRES_DB="geofull_v4"

# Configuración del Servidor Uvicorn / FastAPI
PORT=8000
HOST="0.0.0.0"
WORKERS=4

# Claves opcionales de APIs Externas (OpenAI / Google Maps / Nominatim)
OPENAI_API_KEY=""
GOOGLE_MAPS_API_KEY=""
